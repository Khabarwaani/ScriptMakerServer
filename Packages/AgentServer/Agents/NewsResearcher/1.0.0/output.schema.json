{
  "type": "object",
  "required": [
    "verified",
    "confidence",
    "date"
  ],
  "properties": {
    "verified": {
      "type": "boolean"
    },
    "confidence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{2}-\\d{2}-\\d{2}$",
      "description": "dd-mm-yy"
    },
    "location": {
      "type": [
        "object",
        "string"
      ],
      "properties": {
        "city": { "type": "string" },
        "state": { "type": "string" },
        "country": { "type": "string" }
      },
      "additionalProperties": false
    },
    "people": {
      "type": "array",
      "items": { "type": "string" }
    },
    "notes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "description": "1-3 points, 5-15 words each",
      "items": { "type": "string" }
    },
    "hashtags": {
      "type": "array",
      "maxItems": 5,
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
