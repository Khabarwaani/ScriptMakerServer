{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ThreeSceneStoryCreatorOutput",
  "type": "object",
  "additionalProperties": false,
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "description": "Array of generated 3-scene story packages matching requested output_count.",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "title": "ThreeSceneStoryPackage",
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "scene_1", "scene_2", "scene_3", "verification"],
        "properties": {
          "title": {
            "type": "string",
            "description": "Catchy story title/headline."
          },
          "scene_1": {
            "title": "ThreeSceneItem",
            "type": "object",
            "additionalProperties": false,
            "required": ["purpose", "characters", "setting", "speech", "speech_word_count"],
            "properties": {
              "purpose": { "type": "string", "description": "Purpose/Focus of the scene." },
              "characters": { "type": "string", "description": "Character name(s) or persona(s) appearing in this scene." },
              "setting": { "type": "string", "description": "Setting/Environment where this scene occurs." },
              "speech": { "type": "string", "description": "Spoken dialogue in natural running spoken flow (strictly 20 to 35 words)." },
              "speech_word_count": { "type": "integer", "description": "Exact word count of speech." },
              "joke_applied": { "type": "string", "description": "Optional field showing the joke applied." }
            }
          },
          "scene_2": {
            "title": "ThreeSceneItem",
            "type": "object",
            "additionalProperties": false,
            "required": ["purpose", "characters", "setting", "speech", "speech_word_count"],
            "properties": {
              "purpose": { "type": "string", "description": "Purpose/Focus of the scene." },
              "characters": { "type": "string", "description": "Character name(s) or persona(s) appearing in this scene." },
              "setting": { "type": "string", "description": "Setting/Environment where this scene occurs." },
              "speech": { "type": "string", "description": "Spoken dialogue in natural running spoken flow (strictly 20 to 35 words)." },
              "speech_word_count": { "type": "integer", "description": "Exact word count of speech." },
              "joke_applied": { "type": "string", "description": "Optional field showing the joke applied." }
            }
          },
          "scene_3": {
            "title": "ThreeSceneItem",
            "type": "object",
            "additionalProperties": false,
            "required": ["purpose", "characters", "setting", "speech", "speech_word_count"],
            "properties": {
              "purpose": { "type": "string", "description": "Purpose/Focus of the scene." },
              "characters": { "type": "string", "description": "Character name(s) or persona(s) appearing in this scene." },
              "setting": { "type": "string", "description": "Setting/Environment where this scene occurs." },
              "speech": { "type": "string", "description": "Spoken dialogue in natural running spoken flow (strictly 20 to 35 words)." },
              "speech_word_count": { "type": "integer", "description": "Exact word count of speech." },
              "joke_applied": { "type": "string", "description": "Optional field showing the joke applied (relevant for Scene 3)." }
            }
          },
          "verification": {
            "title": "ThreeSceneVerification",
            "type": "object",
            "additionalProperties": false,
            "required": ["different_concepts", "freshness_maintained", "shareability_verified", "notes"],
            "properties": {
              "different_concepts": { "type": "boolean", "description": "True if Scene 1, 2, and 3 each hold completely different concepts." },
              "freshness_maintained": { "type": "boolean", "description": "True if concept freshness and fresh faces are maintained across all three." },
              "shareability_verified": { "type": "boolean", "description": "True if Scene 3 delivers strong fun/shareability." },
              "notes": { "type": "string", "description": "Short summary of verification check." }
            }
          }
        }
      }
    }
  }
}
