{
  "host": "127.0.0.1",
  "environment": "development",
  "ports": {
    "production": 8081,
    "development": 8080,
    "testing": { "min": 9000, "max": 9999, "max_attempts": 30 }
  },
  "agents_directory": "Agents",
  "shutdown_timeout_seconds": 900,
  "execution_timeout_seconds": 1800,
  "max_processes": 8,
  "provider_pool_size": 5,
  "max_queued_executions": 64,
  "retention_seconds": 3600,
  "providers": {
    "codex": { "executable": "codex", "enabled": true },
    "antigravity": { "executable": "agy", "enabled": true },
    "grok": { "executable": "grok", "enabled": true }
  }
}
